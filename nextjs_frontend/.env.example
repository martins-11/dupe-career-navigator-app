# Next.js local development environment defaults (NON-SECRET)
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Notes:
# - Next.js only exposes variables to the browser if they are prefixed with NEXT_PUBLIC_.
# - Server-side Next.js route handlers can read non-NEXT_PUBLIC variables too, but we keep these
#   consistent and simple for local dev.

# Base URL of the backend API used by Next.js API proxy routes.
# The app contains a safe fallback to http://localhost:3001 if not set, but providing it avoids
# "env vars not set" warnings.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Optional: Some parts of the codebase may check these legacy/alternate names.
# Keep them aligned with NEXT_PUBLIC_BACKEND_URL.
BACKEND_URL=http://localhost:3001

# Optional: set the public site URL when required (e.g., auth redirect URLs if added later).
# For local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enable/disable verbose client logging if supported by the code.
NEXT_PUBLIC_LOG_LEVEL=info
