# Next.js Frontend environment variables (example)
#
# NOTE:
# - The Next.js API route handlers under src/app/api/* proxy to the Express backend.
# - In Kavia/preview/proxy environments, BACKEND_INTERNAL_URL is often the correct internal base URL.
# - At least ONE of the backend URL vars below must be set, or API proxy routes will 500.

# Preferred in preview/proxy environments
BACKEND_INTERNAL_URL=http://localhost:3001

# Public/backend URL options (fallbacks)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE=http://localhost:3001

# Legacy CRA-style fallbacks (some environments still set these)
REACT_APP_BACKEND_URL=http://localhost:3001
REACT_APP_API_BASE=http://localhost:3001
