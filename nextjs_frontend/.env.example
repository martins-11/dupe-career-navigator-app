# Browser-exposed base URL for API calls (optional).
# If omitted, the frontend uses same-origin requests like /uploads/* and relies on Next.js rewrites().
# NEXT_PUBLIC_API_BASE=

# Server-side backend origin used by Next.js rewrites() to proxy API routes in dev.
# In Kavia/dev environments, the Express backend is often NOT reachable at http://localhost:3001
# from the Next.js server process, so set this to the backend container origin.
BACKEND_INTERNAL_URL=http://localhost:3001
#
# Browser-exposed backend URL (client-side fallback).
# Used by src/lib/rolesApi.ts if same-origin rewrites are not in effect.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
#
# --- Optional: Next.js dev HMR WebSocket tuning for preview/proxied HTTPS environments ---
# If the browser console shows it trying to connect to wss://<host>:3000/_next/webpack-hmr, you can
# override the computed websocket URL parts below.
# HMR_PROTOCOL=wss
# HMR_HOSTNAME=0.0.0.0
# HMR_PATHNAME=/_next/webpack-hmr
